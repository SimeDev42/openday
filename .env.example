# Copy to .env and fill in. Never commit .env.

PORT=3000

# Path to the service account key for the openday-fa6a3 project.
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Keep the downloaded JSON outside this repo.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/firebase.json

# Firebase Web app settings (Project settings -> General -> Your apps).
# These values are public identifiers; never put a service account key here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# The first administrator. This Gmail account bypasses the allowlist and can
# add or remove other allowed Gmail accounts from the Access page.
FIREBASE_ADMIN_EMAIL=admin@gmail.com
