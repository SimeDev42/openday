<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title><%= t('Open day') %> · <%= t('Sign in') %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="landing-main" data-locale="<%= locale %>">
      <header class="landing-topbar">
        <a class="brand" href="/login"><span>openday</span></a>
        <%- include('partials/locale-switch') %>
      </header>

      <section class="landing-grid" aria-labelledby="landing-title">
        <div class="landing-copy">
          <p class="eyebrow"><%= t('Visitor registration') %></p>
          <h1 id="landing-title"><%= t('Open day') %></h1>
          <p class="landing-intro"><%= t('Manage visitors, open days, course preferences, and participation records in one place.') %></p>
          <p class="landing-footnote"><%= t('Access is limited to invited Gmail accounts.') %></p>
        </div>

        <section class="login-side login-card" aria-labelledby="login-card-title">
          <p class="login-kicker"><%= t('TEAM ACCESS') %></p>
          <h2 id="login-card-title"><%= t('Sign in') %></h2>
          <p class="login-description"><%= t('Continue with the Google account your administrator approved.') %></p>
          <% if (denied) { %><p class="login-error" role="alert"><%= t('This Google account is not authorized to sign in. Ask your administrator to add it to the team.') %></p><% } %>
          <button class="google-button" type="button" id="google-sign-in"><span><%= t('Continue with Google') %></span></button>
          <p class="login-error" id="login-error" role="alert" hidden></p>
          <p class="login-access-note"><%= t('Only accounts on the team access list can sign in.') %></p>
        </section>
      </section>
    </main>
    <script type="module">
      import { initializeApp } from 'https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js';
      import { getAuth, GoogleAuthProvider, signInWithPopup } from 'https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js';

      const config = <%- JSON.stringify(firebaseConfig) %>;
      const next = <%- JSON.stringify(next) %>;
      const main = document.querySelector('main');
      document.querySelectorAll('[data-locale-form]').forEach((form) => {
        form.addEventListener('submit', () => {
          const destination = form.querySelector('[data-locale-return]');
          if (destination) destination.value = location.pathname + location.search + location.hash;
        });
      });
      const button = document.getElementById('google-sign-in');
      const error = document.getElementById('login-error');
      button.addEventListener('click', async () => {
        button.disabled = true;
        error.hidden = true;
        try {
          const provider = new GoogleAuthProvider();
          provider.setCustomParameters({ prompt: 'select_account' });
          const credential = await signInWithPopup(getAuth(initializeApp(config)), provider);
          const response = await fetch('/session/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ idToken: await credential.user.getIdToken(), next }),
          });
          if (!response.ok) {
            const result = await response.json().catch(() => ({}));
            if (result.code === 'not_authorized') {
              error.textContent = main.dataset.locale === 'it'
                ? 'Questo account Google non è autorizzato. Chiedi all’amministratore di aggiungerlo al team.'
                : 'This Google account is not authorized to sign in. Ask your administrator to add it to the team.';
            } else {
              error.textContent = main.dataset.locale === 'it' ? 'Non è stato possibile accedere. Riprova.' : 'We couldn’t sign you in just now. Please try again.';
            }
            error.hidden = false;
            button.disabled = false;
            return;
          }
          location.assign((await response.json()).redirect);
        } catch {
          error.textContent = main.dataset.locale === 'it' ? 'Accesso Google non completato. Riprova.' : 'Google sign-in did not complete. Please try again.';
          error.hidden = false;
          button.disabled = false;
        }
      });
    </script>
  </body>
</html>
