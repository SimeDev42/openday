rules_version = '2';

// All access goes through the Node server using the Firebase Admin SDK.
// The Admin SDK bypasses rules, so denying every client request costs us
// nothing and means a leaked config or a stray client SDK cannot read or
// write the visitor log.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
